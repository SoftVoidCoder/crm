# Core app security
KORDA_ENV=production
KORDA_APP_SECRET=<set-a-long-random-secret>
KORDA_PUBLIC_BASE_URL=https://your-app.onrender.com
KORDA_COOKIE_SECURE=1
KORDA_DATABASE_URL=postgresql://korda_user:korda@localhost:5432/korda

# Default director bootstrap
KORDA_DIRECTOR_EMAIL=<director-email@example.com>
KORDA_DEFAULT_ADMIN_LOGIN=Admin
KORDA_DEFAULT_ADMIN_PASSWORD=<set-strong-admin-password>

# SMTP defaults for system notifications
KORDA_SMTP_USER=
KORDA_SMTP_PASS=
KORDA_SMTP_HOST=smtp.yandex.ru
KORDA_SMTP_PORT=465

# Operational settings
KORDA_BACKUP_RETENTION_COUNT=14
KORDA_MAIL_SYNC_BATCH=40
KORDA_MAIL_IMAP_TIMEOUT=20
KORDA_MAIL_SMTP_TIMEOUT=20

# Optional DaData integration for INN auto-check
KORDA_DADATA_TOKEN=
KORDA_DADATA_SECRET=
